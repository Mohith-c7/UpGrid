# Copy to .env (never commit it). Every variable here is read at build/bundle time (EXPO_PUBLIC_*),
# so it ends up inside the app: put only public identifiers here, never secrets.

# Base URL of the Placement OS API, including /api/v1 (no trailing slash).
# Android emulator -> host machine: http://10.0.2.2:4000/api/v1
EXPO_PUBLIC_API_URL=https://YOUR-RENDER-SERVICE.onrender.com/api/v1

# --- Google sign-in (optional: the button is hidden when the server flag is off or the id for the platform is empty) ---
# OAuth client IDs from Google Cloud Console > APIs & Services > Credentials. Format: 1234567890-abc.apps.googleusercontent.com
# Android client (package com.placementos.app + SHA-1 of the signing key). REQUIRED for Google sign-in on Android.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# iOS client (bundle id com.placementos.app). Only needed for iOS builds.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Web client. Used for web/Expo Go style runs; the server must list the same ids in its GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Cloudflare Turnstile (optional) ---
# The site key comes from GET /config, not from here. This is only the https origin the widget WebView pretends to be on;
# it must be one of the hostnames on the Turnstile widget. Leave empty to use the API origin.
# Example: https://placement-os.onrender.com
EXPO_PUBLIC_TURNSTILE_BASE_URL=
