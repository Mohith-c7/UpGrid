# Copy to .env for local development. Every variable the server reads is listed here.
# Nothing below except DATABASE_URL / JWT_SECRET / OFFICER_INVITE_CODE is required: every integration
# switches itself off (clean 503 / feature flag false in GET /api/v1/config) when its keys are missing.
# Step-by-step setup for each provider: INTEGRATIONS.md

# ============================================================ core
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/placement_os
# Min 24 chars. REQUIRED in production (Render generates one).
JWT_SECRET=change-me-to-a-long-random-string
# Officers must present this code to self-register. REQUIRED in production.
OFFICER_INVITE_CODE=change-me-invite
# Comma-separated origins, or * (native apps send no Origin header; set real web origins if you add a web client)
CORS_ORIGINS=*
BCRYPT_ROUNDS=10
# Poll interval (ms) of the in-process workers (reminders, announcements, pipeline slots/offers).
# Set DISABLE_SCHEDULER=1 to run the API without ANY in-process worker (reminders, announcements, assessments, pipeline).
SCHEDULER_INTERVAL_MS=30000
# DISABLE_SCHEDULER=1
# Set PGSSL=1 if your managed Postgres requires SSL and the URL has no sslmode.
# PGSSL=1
# `npm run seed` WIPES data and refuses to run in production unless this is 1.
# SEED_FORCE=1
# Tests only (throwaway database, tables are TRUNCATEd): postgres://app@localhost:5433/placement_test
# TEST_DATABASE_URL=

# ============================================================ email (SMTP via nodemailer)
# Used for: sign-up verification code, password reset code, schedule / offer / ticket-reply notifications.
# Leave SMTP_HOST empty to turn email OFF: development prints mails to the console (JSON transport); production logs a
# no-op and GET /config reports emailVerification=false. The API never returns verification codes.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); false for STARTTLS on 587. Default: true only when SMTP_PORT=465.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From header, e.g. Placement OS <no-reply@yourdomain.com>. Use an address your SMTP provider has verified.
MAIL_FROM=
# Brand name used in mail subjects and templates.
APP_NAME=Placement OS
# Development only: 1 = also print the 6-digit codes to the server console (ignored when NODE_ENV=production).
# EMAIL_DEV_ECHO=1
# Applying needs a verified email. Default: true when SMTP_HOST is set, false otherwise. true/false overrides
# (it is always off when email is not configured, so nobody gets locked out).
# REQUIRE_VERIFIED_EMAIL=true

# ============================================================ Google sign-in
# OAuth client IDs, comma separated, in the order web,android,ios (web is required for the Expo app on every platform).
# Or label them: web:xxx.apps.googleusercontent.com,android:yyy.apps.googleusercontent.com,ios:zzz.apps.googleusercontent.com
# Empty = Google sign-in off.
GOOGLE_CLIENT_IDS=
# Alternative to the labelled list (one variable per platform):
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=

# ============================================================ Cloudflare Turnstile (captcha on register/login/forgot-password/google)
# The secret enables enforcement. The site key is public and is handed to the app by GET /config.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# ============================================================ Cloudflare R2 (resume / photo / logo / document uploads)
# All four of ACCOUNT_ID, ACCESS_KEY_ID, SECRET_ACCESS_KEY and BUCKET are needed; otherwise /files routes answer 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket (custom domain or r2.dev), used ONLY for company logos, e.g. https://files.yourdomain.com
# Everything else stays private and is served with 5-minute signed URLs.
R2_PUBLIC_BASE_URL=

# ============================================================ code execution for coding tests (Judge0; module: assessments)
# Untrusted code is never run on this server. Empty JUDGE0_URL = features.codeExecution=false (coding questions cannot be published).
# Self-hosted Judge0 or the RapidAPI "Judge0 CE" listing, e.g. https://judge0-ce.p.rapidapi.com
JUDGE0_URL=
# RapidAPI key (sent as X-RapidAPI-Key). Leave empty for a self-hosted instance.
JUDGE0_API_KEY=
# RapidAPI host header (X-RapidAPI-Host), e.g. judge0-ce.p.rapidapi.com
JUDGE0_API_HOST=
# Self-hosted instances that set AUTHN_TOKEN: sent as X-Auth-Token.
JUDGE0_AUTH_TOKEN=
# Optional JSON override of Judge0 language ids, e.g. {"python":71,"javascript":63}. Invalid JSON is ignored.
# JUDGE0_LANGUAGE_IDS=

# ============================================================ AI (Gemini; module: ai)
# Option A: Google AI Studio key. Option B: Vertex AI (project + location + service-account JSON, one line).
# With none of them set, features.ai=false and AI endpoints answer 503 AI_NOT_CONFIGURED.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
# Whole service-account key file contents as a single-line JSON string (Vertex only).
GOOGLE_APPLICATION_CREDENTIALS_JSON=
AI_MODEL=gemini-flash-lite-latest
# Per student per UTC day (officers / recruiters: AI_DAILY_LIMIT_STAFF).
AI_DAILY_LIMIT=30
# AI_DAILY_LIMIT_STAFF=300
# AI_TIMEOUT_MS=25000
# Require the student's consent before their data is shown to recruiter-side AI tools (module: ai).
# AI_REQUIRE_CANDIDATE_CONSENT=true
# AI_BURST_PER_MINUTE=10         # per user
# AI_CACHE_TTL_SECONDS=86400
# AI_RETRY_BACKOFF_MS=500
# Kill switch: false turns AI off even when keys are present.
AI_ENABLED=true
